pop <- load_imported_pop("Leishmaniasis Project/Files_to_Qusai/R/shinyapp/censored_WB_shinyapp/Miltsim/100boostraped_pop_SouthSudan_Lankien_VL_Demographics_1998-2019_ID_added.csv"
,0,200,0,30,0,200)
pop <- load_imported_pop("Leishmaniasis Project/Files_to_Qusai/R/shinyapp/censored_WB_shinyapp/Miltsim/100boostraped_pop_SouthSudan_Lankien_VL_Demographics_1998-2019_ID_added.csv"
,0,200,0,30,0,200)
model <- mread("Miltsim/helper_functions/wendysmodel_VL.cpp")
loadso(model)
id_count <- pop$WHO_data_HT_WT_FFM$ID
maintenance_dose_addl <- 28 - 1
maintenance_dose_ii <- 24
treatment_duration <- 28
dose <- ev(amt = 0, cmt = 1, II = maintenance_dose_ii,
ADDL = maintenance_dose_addl, time = 0)
multiple_dose_data <- ev_rep(dose, ID = id_count) %>% rename(EVID= evid, TIME=time,
CMT=cmt, AMT = amt)
Sim_data <- pop$WHO_data_HT_WT_FFM %>%
merge(multiple_dose_data, by = "ID", all.x = TRUE)
THETA0 <- 3.5293918      # baseline adherence
THETA1 <- -0.3368967   # pill burden effect
NM_Allo <- Sim_data %>%
# filter(WT<30) %>%
mutate(
FLOORED_HT = ((HT %/% 10) *10),
FLOORED_WT = floor(WT),
FFM_2005 = ifelse(SEX == 0,
((9.27e3 * FLOORED_WT) / (6.68e3 + 216 * (FLOORED_WT / ((FLOORED_HT / 100) ^ 2)))),
((9.27e3 * FLOORED_WT) / (8.78e3 + 244 * (FLOORED_WT / ((FLOORED_HT / 100) ^ 2)))))
) %>%
mutate(
AMT = ifelse(EVID == 1, case_when(
WT >= 45 ~ 150,
WT >= 30 & WT < 45 ~ 100,
WT < 30 ~ plyr::round_any(150 * (FFM_2005 / 53) ^ 0.75, 10)
), 0),
SEX = as.numeric(SEX)) %>%
mutate(AMT = ifelse(AMT == 90, 100, AMT),
PILLS = ceiling(calculate_pillcount(AMT,NULL)),
LOGIT_ADH = THETA0 + THETA1*PILLS,
# ADH = 1,
ADH = exp(LOGIT_ADH)/(1+exp(LOGIT_ADH))
) %>%
dplyr::select(ID, TIME, EVID, CMT, II, ADDL, AMT,PILLS,ADH, AGE, SEX, HT, WT, FFM) %>%
arrange(ID, TIME)
set.seed(9119)
allometric_ffm_model <- model %>%
data_set(NM_Allo) %>%
carry.out(a.u.g) %>%
obsaug %>%
# param(TSWITCH= (treatment_duration + 0)*24)%>%
mrgsim(delta = 24, end = 60 * 24)%>%
as.data.frame()
allometric_ffm <- allometric_ffm_model %>% group_by(ID) %>%
mutate( AMT = max(AMT))
View(NM_Allo)
View(pop)
View(pop[["WHO_data_HT_WT_FFM"]])
